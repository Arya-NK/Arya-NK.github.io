source "https://rubygems.org"

# Use explicit Jekyll so we can upgrade beyond the github-pages bundle
gem "jekyll", "~> 4.2"
gem "webrick"  # Required for Ruby 3+

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-gist"
  gem "jekyll-mentions"
  gem "jemoji"
end

# Development tooling
group :development do
  gem "html-proofer", "~> 4.4"
end
